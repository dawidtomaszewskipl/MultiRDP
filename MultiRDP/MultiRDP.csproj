<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MultiRDP</RootNamespace>
    <AssemblyName>MultiRDP</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <!-- Interop DLL wygenerowane przez aximp.exe z C:\Windows\System32\mstscax.dll -->
  <!-- Interop DLLs generated by aximp.exe from C:\Windows\System32\mstscax.dll -->
  <ItemGroup>
    <Reference Include="MSTSCLib">
      <HintPath>libs\MSTSCLib.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="AxInterop.MSTSCLib">
      <HintPath>libs\AxInterop.MSTSCLib.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <!-- Kopiuj DLL interop do katalogu wyjściowego / Copy interop DLLs to output directory -->
  <ItemGroup>
    <None Include="libs\MSTSCLib.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="libs\AxInterop.MSTSCLib.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
