<Window x:Class="MultiRDP.Views.SecondaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="MultiRDP — RDP"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Black"
        AllowsTransparency="False"
        ShowInTaskbar="False">

    <!-- Okno rozciągnięte na oba monitory — zawiera wyłącznie kontrolkę RDP (UseMultimon=true) -->
    <!-- Window spanning both monitors — contains only the RDP control (UseMultimon=true) -->
    <wf:WindowsFormsHost x:Name="RdpHost"
                         Background="Black"/>

</Window>
