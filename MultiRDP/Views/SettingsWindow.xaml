<Window x:Class="MultiRDP.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ustawienia — MultiRDP"
        Width="560"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#1A1A1A"
        Foreground="#EEEEEE">

    <Window.Resources>
        <!-- Styl etykiety / Label style -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Styl pola tekstowego / TextBox style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#3D3D3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#EEEEEE"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#0078D4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Styl pola hasła / PasswordBox style -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#3D3D3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Styl elementu listy ComboBox / ComboBox item style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background"  Value="#2A2A2A"/>
            <Setter Property="Foreground"  Value="#EEEEEE"/>
            <Setter Property="Padding"     Value="10,6"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0078D4"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                    <Setter Property="Foreground"  Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Styl listy wyboru / ComboBox style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"         Value="#2A2A2A"/>
            <Setter Property="Foreground"         Value="#EEEEEE"/>
            <Setter Property="BorderBrush"        Value="#3D3D3D"/>
            <Setter Property="Padding"            Value="8,5"/>
            <Setter Property="FontFamily"         Value="Segoe UI"/>
            <Setter Property="FontSize"           Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="#2A2A2A"
                                          BorderBrush="#3D3D3D"
                                          BorderThickness="1"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="8,5,0,5"
                                                                  VerticalAlignment="Center"/>
                                                <Path Grid.Column="1"
                                                      Data="M0,0 L4,4 L8,0"
                                                      Stroke="#AAAAAA"
                                                      StrokeThickness="1.5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#0078D4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,5,24,5"
                                              VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#EEEEEE"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize"   Value="12"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#2A2A2A"
                                            BorderBrush="#3D3D3D"
                                            BorderThickness="1"
                                            CornerRadius="0,0,2,2">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl przycisku głównego / Primary button style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl przycisku drugorzędnego / Secondary button style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A4A4A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Styl separatora sekcji / Section separator style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0078D4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Tytuł / Title -->
            <RowDefinition Height="*"/>
            <!-- Zawartość / Content -->
            <RowDefinition Height="Auto"/>
            <!-- Przyciski / Buttons -->
        </Grid.RowDefinitions>

        <!-- Tytuł okna / Window title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Ustawienia"
                       FontSize="20"
                       FontWeight="Light"
                       Foreground="#EEEEEE"
                       FontFamily="Segoe UI"/>
            <Rectangle Height="1"
                       Fill="#2D2D2D"
                       Margin="0,12,0,0"/>
        </StackPanel>

        <!-- Zawartość ustawień / Settings content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- === SEKCJA HOST 1 / HOST 1 SECTION === -->
                <TextBlock Text="▸ HOST 1"
                           Style="{StaticResource SectionHeaderStyle}"/>
                <Border Background="#222222"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Nazwa / Adres -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Nazwa wyświetlana" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TxtH1Name"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Adres IP / Hostname" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TxtH1Address"/>
                        </StackPanel>

                        <!-- Użytkownik / Port -->
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Nazwa użytkownika" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TxtH1Username"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Port (domyślnie 3389)" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TxtH1Port"/>
                        </StackPanel>

                        <!-- Hasło / Domena -->
                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="Hasło" Style="{StaticResource LabelStyle}"/>
                            <PasswordBox x:Name="PwdH1Password"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="Domena (opcjonalnie)" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TxtH1Domain"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- === SEKCJA HOST 2 / HOST 2 SECTION === -->
                <TextBlock Text="▸ HOST 2"
                           Style="{StaticResource SectionHeaderStyle}"/>
                <Border Background="#222222"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Nazwa wyświetlana" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TxtH2Name"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Adres IP / Hostname" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TxtH2Address"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Nazwa użytkownika" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TxtH2Username"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Port (domyślnie 3389)" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TxtH2Port"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="Hasło" Style="{StaticResource LabelStyle}"/>
                            <PasswordBox x:Name="PwdH2Password"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="Domena (opcjonalnie)" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TxtH2Domain"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- === SEKCJA MONITORY / MONITORS SECTION === -->
                <TextBlock Text="▸ MONITORY"
                           Style="{StaticResource SectionHeaderStyle}"/>
                <Border Background="#222222"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,8">
                    <StackPanel>

                        <!-- Przycisk identyfikacji wszystkich monitorów -->
                        <Button x:Name="BtnIdentifyAll"
                                Content="👁 Identyfikuj wszystkie monitory (2 sek.)"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,14"
                                Padding="12,7"
                                Click="BtnIdentifyAll_Click"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Monitor główny -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Monitor główny (pasek + ekran 1)"
                                           Style="{StaticResource LabelStyle}"/>
                                <DockPanel>
                                    <Button x:Name="BtnIdentify1"
                                            DockPanel.Dock="Right"
                                            Content="👁"
                                            ToolTip="Pokaż który to monitor"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="8,5"
                                            Margin="6,0,0,0"
                                            Click="BtnIdentify1_Click"/>
                                    <ComboBox x:Name="CmbMonitor1"/>
                                </DockPanel>
                            </StackPanel>

                            <!-- Monitor drugi -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Monitor drugi (ekran 2)"
                                           Style="{StaticResource LabelStyle}"/>
                                <DockPanel>
                                    <Button x:Name="BtnIdentify2"
                                            DockPanel.Dock="Right"
                                            Content="👁"
                                            ToolTip="Pokaż który to monitor"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="8,5"
                                            Margin="6,0,0,0"
                                            Click="BtnIdentify2_Click"/>
                                    <ComboBox x:Name="CmbMonitor2"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Przyciski Zapisz / Anuluj -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Anuluj"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"
                    Click="BtnCancel_Click"/>
            <Button Content="Zapisz i zastosuj"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
