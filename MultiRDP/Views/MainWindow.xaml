<Window x:Class="MultiRDP.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <Window.Resources>
        <Style x:Key="HostTabStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252525"/>
                                <Setter Property="Foreground" Value="#EEEEEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HostTabActiveStyle" TargetType="Button" BasedOn="{StaticResource HostTabStyle}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#106EBE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconBtnStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#888888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,7"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252525"/>
                                <Setter Property="Foreground" Value="#EEEEEE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuItemBtnStyle" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="#DDDDDD"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Padding"                    Value="16,9"/>
            <Setter Property="FontFamily"                 Value="Segoe UI"/>
            <Setter Property="FontSize"                   Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuItemCloseBtnStyle" TargetType="Button" BasedOn="{StaticResource MenuItemBtnStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                    <Setter Property="Foreground"  Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Główny panel / Main panel -->
        <Border x:Name="RootBorder"
                Background="#EE111111"
                CornerRadius="0,0,8,8"
                Padding="4,4"
                MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Wskaźnik statusu / Status indicator -->
                <Ellipse x:Name="StatusDot"
                         Width="7" Height="7"
                         Fill="#444"
                         Margin="6,0,6,0"
                         VerticalAlignment="Center"/>

                <!-- Zakładki hostów / Host tabs -->
                <ItemsControl x:Name="HostTabsPanel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Separator -->
                <Rectangle Width="1" Fill="#2A2A2A" Margin="4,4" VerticalAlignment="Stretch"/>

                <!-- Przycisk menu ⋯ / Menu button ⋯ -->
                <Button x:Name="BtnMenu"
                        Content="⋯"
                        Style="{StaticResource IconBtnStyle}"
                        ToolTip="Menu"
                        Click="BtnMenu_Click"/>

            </StackPanel>
        </Border>

        <!-- Menu popup / Menu popup -->
        <Popup x:Name="MenuPopup"
               PlacementTarget="{Binding ElementName=BtnMenu}"
               Placement="Bottom"
               VerticalOffset="4"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Background="#EE111111"
                    BorderBrush="#2A2A2A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.65"/>
                </Border.Effect>
                <StackPanel MinWidth="200">

                    <!-- Przypnij/Odepnij / Pin/Unpin -->
                    <Button x:Name="BtnPinMenuItem"
                            Content="📌  Odepnij (auto-chowaj)"
                            Style="{StaticResource MenuItemBtnStyle}"
                            Click="BtnPin_Click"/>

                    <Rectangle Height="1" Fill="#252525" Margin="8,3"/>

                    <!-- Połącz / Connect -->
                    <Button Content="▶  Połącz"
                            Style="{StaticResource MenuItemBtnStyle}"
                            Foreground="#4CAF50"
                            Click="BtnConnect_Click"/>

                    <!-- Rozłącz / Disconnect -->
                    <Button Content="■  Rozłącz"
                            Style="{StaticResource MenuItemBtnStyle}"
                            Foreground="#EF5350"
                            Click="BtnDisconnect_Click"/>

                    <Rectangle Height="1" Fill="#252525" Margin="8,3"/>

                    <!-- Ustawienia / Settings -->
                    <Button Content="⚙  Ustawienia"
                            Style="{StaticResource MenuItemBtnStyle}"
                            Click="BtnSettings_Click"/>

                    <Rectangle Height="1" Fill="#252525" Margin="8,3"/>

                    <!-- Zamknij / Close -->
                    <Button Content="✕  Zamknij aplikację"
                            Style="{StaticResource MenuItemCloseBtnStyle}"
                            Click="BtnClose_Click"/>

                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
