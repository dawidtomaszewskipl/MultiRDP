<Window x:Class="MultiRDP.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <Window.Resources>
        <Style x:Key="HostTabStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,7,14,7"/>
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Focusable"       Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252525"/>
                    <Setter Property="Foreground" Value="#EEEEEE"/>
                </Trigger>
                <!-- Aktywna zakładka / Active tab -->
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="#0078D4"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsActive}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#106EBE"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Kropka statusu sesji / Session status dot -->
        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width"             Value="7"/>
            <Setter Property="Height"            Value="7"/>
            <Setter Property="Margin"            Value="0,0,7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill"              Value="#5A5A5A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Connected">
                    <Setter Property="Fill" Value="#4CAF50"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Connecting">
                    <Setter Property="Fill" Value="Orange"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Reconnecting">
                    <Setter Property="Fill" Value="Orange"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter Property="Fill" Value="#EF5350"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconBtnStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#888888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,7"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252525"/>
                                <Setter Property="Foreground" Value="#EEEEEE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuItemBtnStyle" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="#DDDDDD"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Padding"                    Value="16,9"/>
            <Setter Property="FontFamily"                 Value="Segoe UI"/>
            <Setter Property="FontSize"                   Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuItemCloseBtnStyle" TargetType="Button" BasedOn="{StaticResource MenuItemBtnStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                    <Setter Property="Foreground"  Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Główny panel / Main panel -->
        <Border x:Name="RootBorder"
                Background="#EE111111"
                CornerRadius="0,0,8,8"
                Padding="4,4"
                MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Zakładki sesji (1–4) / Session tabs (1–4) -->
                <ItemsControl ItemsSource="{Binding Sessions}" Margin="2,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource HostTabStyle}"
                                    Command="{Binding DataContext.SelectSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding ToolTip}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource StatusDotStyle}"/>
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Separator -->
                <Rectangle Width="1" Fill="#2A2A2A" Margin="4,4" VerticalAlignment="Stretch"/>

                <!-- Przycisk menu ⋯ / Menu button ⋯ -->
                <Button x:Name="BtnMenu"
                        Content="⋯"
                        Style="{StaticResource IconBtnStyle}"
                        ToolTip="Menu"
                        Click="BtnMenu_Click"/>

            </StackPanel>
        </Border>

        <!-- Menu popup / Menu popup -->
        <Popup x:Name="MenuPopup"
               PlacementTarget="{Binding ElementName=BtnMenu}"
               Placement="Bottom"
               VerticalOffset="4"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Background="#EE111111"
                    BorderBrush="#2A2A2A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.65"/>
                </Border.Effect>
                <StackPanel MinWidth="200">

                    <!-- Przypnij/Odepnij / Pin/Unpin -->
                    <Button x:Name="BtnPinMenuItem"
                            Content="📌  Odepnij (auto-chowaj)"
                            Style="{StaticResource MenuItemBtnStyle}"
                            Click="BtnPin_Click"/>

                    <Rectangle Height="1" Fill="#252525" Margin="8,3"/>

                    <!-- Połącz / Connect -->
                    <Button Content="▶  Połącz"
                            Style="{StaticResource MenuItemBtnStyle}"
                            Foreground="#4CAF50"
                            Click="BtnConnect_Click"/>

                    <!-- Rozłącz / Disconnect -->
                    <Button Content="■  Rozłącz"
                            Style="{StaticResource MenuItemBtnStyle}"
                            Foreground="#EF5350"
                            Click="BtnDisconnect_Click"/>

                    <!-- Połącz wszystkie / Connect all -->
                    <Button Content="↻  Połącz ponownie wszystkie"
                            Style="{StaticResource MenuItemBtnStyle}"
                            Click="BtnConnectAll_Click"/>

                    <Rectangle Height="1" Fill="#252525" Margin="8,3"/>

                    <!-- Ustawienia / Settings -->
                    <Button Content="⚙  Ustawienia (Ctrl+,)"
                            Style="{StaticResource MenuItemBtnStyle}"
                            Click="BtnSettings_Click"/>

                    <Rectangle Height="1" Fill="#252525" Margin="8,3"/>

                    <!-- Zamknij / Close -->
                    <Button Content="✕  Zamknij aplikację"
                            Style="{StaticResource MenuItemCloseBtnStyle}"
                            Click="BtnClose_Click"/>

                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
